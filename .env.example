# ============================================================================
# N-REV — Environment configuration template
# ============================================================================
# Copy this file to `.env` at the repository root and fill in real values.
# NEVER commit `.env` — it contains secrets. Only this template is tracked.
#
#   cp .env.example .env
#
# All values below are PLACEHOLDERS. Do not put real secrets here.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by the API server and Drizzle.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nutrirecover

# --- Server -----------------------------------------------------------------
# HTTP port the API server listens on. Required by the backend.
PORT=8099

# Set to "production" in production deployments; development/pino-pretty logs
# otherwise.
# NODE_ENV=development

# Pino log level (trace|debug|info|warn|error). Optional, defaults to info.
# LOG_LEVEL=info

# --- Admin API --------------------------------------------------------------
# Shared secret required to call /api/admin/* endpoints (sent as the
# `x-admin-key` request header). Admin routes return 403 while this is
# unset. Generate a strong random value, e.g. `openssl rand -hex 32`.
# ADMIN_SECRET_KEY=change-me-to-a-strong-random-value

# --- Frontend (Vite) --------------------------------------------------------
# Optional. Backend URL the Vite dev-server proxies `/api` to.
# Defaults to http://127.0.0.1:8099.
# VITE_API_TARGET=http://127.0.0.1:8099

# Optional alias for the above.
# API_URL=http://127.0.0.1:8099

# Optional base path for a non-root deployment. Defaults to "/".
# BASE_PATH=/
