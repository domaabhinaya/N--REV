# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.10.0 --activate

# .dockerignore excludes .env files, local dependencies, build output, and
# dataset source spreadsheets. Runtime secrets are supplied by Vercel only.
COPY . .

RUN pnpm install --frozen-lockfile \
  && pnpm --filter @workspace/api-server build \
  && pnpm --filter @workspace/nutrirecover build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    NREV_STATIC_DIR=/app/public

# The API build is self-contained. Do not copy workspace node_modules, .env,
# local PostgreSQL, or XLSX source data into the runtime image.
COPY --from=build /app/artifacts/api-server/dist ./artifacts/api-server/dist
COPY --from=build /app/artifacts/nutrirecover/dist/public ./public
COPY --from=build /app/docker/vercel-server.mjs ./docker/vercel-server.mjs

EXPOSE 80

# Vercel supplies PORT (default 80 for container functions).
CMD ["node", "--enable-source-maps", "./docker/vercel-server.mjs"]
