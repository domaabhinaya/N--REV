{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/nutrirecover build",
  "outputDirectory": "artifacts/nutrirecover/dist/public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "includeFiles": [
        "artifacts/api-server/**",
        "lib/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
